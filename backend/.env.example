# ===========================================
# AWS — the only thing this file needs
# ===========================================
# All secrets and app config (region, S3, email, admin id, Stripe, JWT, LLM
# keys, ...) are hydrated from AWS Secrets Manager (`portfolio-app/production`)
# at boot. See docs/guides/SECRETS_MANAGEMENT.md.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key