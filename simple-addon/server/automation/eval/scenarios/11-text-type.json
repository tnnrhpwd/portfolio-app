{
  "id": "11-text-type",
  "name": "text_type + input_tap end-to-end into a real Notepad window",
  "description": "Real, non-dry-run smoke test for key simulation: launches an actual Notepad process, types a unique marker string into it via SendKeys (text_type), selects-all and copies via raw key-down/up events (input_tap ctrl+a, ctrl+c), then reads the OS clipboard back and asserts the marker round-tripped through a real foreground window before closing Notepad. This exercises the literal OS input APIs (SendKeys + keybd_event), not a mock. NOTE: the previous version of this scenario used an unsupported top-level tool/args shape that the runner silently skipped (0 steps executed, vacuous pass) — see runner.js's steps/http-only dispatch.",
  "require": { "platform": "win32" },
  "permissions": {
    "categories": { "shell": "allow", "system": "allow", "safe-read": "allow" }
  },
  "steps": [
    {
      "tool": "shell_run",
      "args": { "command": "Start-Process notepad; Start-Sleep -Milliseconds 800; Write-Output 'launched'" },
      "expect": {
        "ok": true,
        "resultPath": "stdout",
        "resultContains": "launched",
        "durationMsLte": 15000
      }
    },
    {
      "tool": "text_type",
      "args": { "text": "simple-eval-marker-9f13", "focusWindowTitle": "Notepad" },
      "expect": {
        "ok": true,
        "resultPath": "strategy",
        "resultEquals": "sendkeys",
        "durationMsLte": 15000
      }
    },
    {
      "tool": "input_tap",
      "args": { "keys": ["ctrl", "a"], "focusWindowTitle": "Notepad" },
      "expect": {
        "ok": true,
        "resultPath": "ok",
        "resultEquals": true,
        "durationMsLte": 10000
      }
    },
    {
      "tool": "input_tap",
      "args": { "keys": ["ctrl", "c"], "focusWindowTitle": "Notepad" },
      "expect": {
        "ok": true,
        "resultPath": "ok",
        "resultEquals": true,
        "durationMsLte": 10000
      }
    },
    {
      "tool": "clipboard_read",
      "args": {},
      "expect": {
        "ok": true,
        "resultPath": "text",
        "resultContains": "simple-eval-marker-9f13"
      }
    },
    {
      "tool": "shell_run",
      "args": { "command": "Get-Process notepad -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Output 'closed'" },
      "expect": {
        "ok": true,
        "resultPath": "stdout",
        "resultContains": "closed",
        "durationMsLte": 15000
      }
    }
  ],
  "tags": ["input", "typing", "smoke", "e2e"]
}
