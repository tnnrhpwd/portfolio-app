{
  "$comment": "Source spec for scripts/rocket/extract-sprites.js. `names` are applied to the detected sprites in reading order (rows top->bottom, left->right). `exclude` rects (fractions of the sheet unless \"unit\":\"px\") hide baked-in text that survives the text filter. `regions` are hand-placed crops for content the detector cannot judge (e.g. grey UI stars look exactly like caption glyphs).",
  "defaults": {
    "pad": 12,
    "minSize": 30,
    "maxDim": 160,
    "$comment": "Sprites are drawn small on a 1280x720 canvas, so 160px is plenty for anything but hero/background art. Cartoon art with soft glows is very expensive as 32-bit PNG (~80 KB at 256px), so exports are palette-quantised: that is what keeps the whole set in the low single-digit MB instead of ~20.",
    "png": {
      "compressionLevel": 9,
      "palette": true,
      "quality": 92,
      "effort": 8,
      "dither": 0.6
    }
  },
