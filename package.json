{
  "name": "sthopwood",
  "version": "1.0.0",
  "author": "Steven Tanner Hopwood <steven.t.hopwood@gmail.com>",
  "scripts": {
    "start": "concurrently -n frontend,backend -c blue,green \"npm start --silent --prefix frontend\" \"npm run server --silent --prefix backend\"",
    "dev": "concurrently -n frontend,backend -c blue,green \"npm start --silent --prefix frontend\" \"npm run dev --silent --prefix backend\"",
    "build": "npm run build --prefix frontend",
    "test": "jest --verbose --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-all": "npm install && concurrently \"npm install --prefix frontend\" \"npm install --prefix backend\"",
    "build:netlify": "npm install --prefix frontend && npm run build --prefix frontend",
    "health-check": "node scripts/health-check.js",
    "env:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-env.ps1",
    "env:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-env.ps1",
    "env:add-recipient": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/add-env-recipient.ps1",
    "secret:put": "node backend/scripts/put-secret.js",
    "secret:remove": "node backend/scripts/put-secret.js -Delete",
    "secret:seed": "node backend/scripts/seed-secrets.js",
    "secret:list": "node backend/scripts/list-secret.js",
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.14.9",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.29.7",
    "@netlify/plugin-sitemap": "^0.8.1",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less)$": "identity-obj-proxy",
      "\\.(svg)$": "identity-obj-proxy",
      "\\.(png|jpg|jpeg|gif|webp)$": "<rootDir>/frontend/src/assets/__mocks__/mock.js"
    },
    "testEnvironment": "jest-environment-jsdom"
  },
  "overrides": {
    "semver": "^7.6.0"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "phaser": "^4.2.1"
  }
}
